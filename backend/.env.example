PORT=4000

# Comma-separated emails of existing accounts allowed into /admin.
# Create the account through the normal signup flow first, then add its email here.
ADMIN_EMAILS=

# Set to "production" on Railway. Enables the JWT_SECRET/CRON_SECRET
# requirements, the stricter auth rate limit and proxy-aware client IPs.
NODE_ENV=
DB_PATH=./turpoint.db

# Required in any real deployment - falls back to a dev-only default
# otherwise (see src/lib/jwt.js). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of allowed frontend origins, e.g.
#   CORS_ORIGIN=https://turpoint.vercel.app
# Leave unset in local dev - the API then accepts requests from any origin,
# which is what localhost:3000 needs with no extra config.
CORS_ORIGIN=

# Shared secret for POST /api/group-formations/expire-past-due.
# REQUIRED when NODE_ENV=production (the route refuses to run without it).
# Leave unset locally. Set it in production and pass the same value as an
# `x-cron-secret` header from whatever scheduler calls that route, so it
# isn't a publicly triggerable "cancel things" endpoint.
CRON_SECRET=

# Groq API key for the AI-powered Smart Planner (see src/lib/groq.js).
# Free tier - get one at https://console.groq.com/keys. Without this set,
# the planner endpoint returns a friendly "AI unavailable" error instead of
# crashing.
GROQ_API_KEY=

# Where uploaded photos are stored. On Railway point this at a mounted volume
# (e.g. UPLOADS_DIR=/data/uploads next to DB_PATH=/data/turpoint.db), otherwise
# every redeploy wipes the photos. Defaults to backend/uploads for local dev.
UPLOADS_DIR=

# There is no SMS provider yet, so phone verification is a fixed-code MOCK.
# In production the verify endpoints answer 501 unless this is "true"
# (only enable for demos - anyone can then verify any number).
ALLOW_MOCK_PHONE_VERIFICATION=

# Stormglass API key for the homepage "Weather in Azerbaijan" panel
# (see src/lib/stormglass.js) - get one at https://stormglass.io. Without it
# the panel is simply hidden. The free plan allows 10 requests/day and each
# of the 6 cities is one request, so forecasts are cached in the database
# for STORMGLASS_CACHE_HOURS (default 6); raise it if you hit the limit.
STORMGLASS_API_KEY=
STORMGLASS_CACHE_HOURS=

# Automatic demo setup for hosts without a persistent disk (e.g. Render's free
# plan, which wipes the SQLite file on every deploy, restart and sleep).
# With AUTO_SEED_DEMO=true, a backend that starts with NO tours recreates the
# showcase tours (dated from tomorrow, with last-minute deals) and these
# logins. A database that already has tours is never touched. Passwords must
# be at least 6 characters and are never written to the logs.
#   DEMO_OPERATOR_PASSWORD -> operator.demo@turpoint.test (owns the tours)
#   DEMO_TRAVELER_PASSWORD -> traveler.demo@turpoint.test
#   ADMIN_PASSWORD         -> the first email in ADMIN_EMAILS
# Leave AUTO_SEED_DEMO unset for a real deployment with real users.
AUTO_SEED_DEMO=
DEMO_OPERATOR_PASSWORD=
DEMO_TRAVELER_PASSWORD=
ADMIN_PASSWORD=
