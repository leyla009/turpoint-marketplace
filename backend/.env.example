PORT=4000
DB_PATH=./turpoint.db

# Required in any real deployment - falls back to a dev-only default
# otherwise (see src/lib/jwt.js). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of allowed frontend origins, e.g.
#   CORS_ORIGIN=https://turpoint.vercel.app
# Leave unset in local dev - the API then accepts requests from any origin,
# which is what localhost:3000 needs with no extra config.
CORS_ORIGIN=

# Optional shared secret for POST /api/group-formations/expire-past-due.
# Leave unset locally. Set it in production and pass the same value as an
# `x-cron-secret` header from whatever scheduler calls that route, so it
# isn't a publicly triggerable "cancel things" endpoint.
CRON_SECRET=
