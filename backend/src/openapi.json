{
  "openapi": "3.0.3",
  "info": {
    "title": "TurPoint API",
    "version": "0.2.0",
    "description": "Tour marketplace API - operators, tours, group formation pricing, bookings, reviews, deals, and the smart trip planner. Most write operations and anything scoped to \"the logged-in account\" require a Bearer JWT; identity is always derived from the verified token, never from the request body."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "summary": "Create a new account",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "name": "Aysel Mammadova",
                "email": "aysel@example.com",
                "password": "secret123"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created, returns user + JWT"
          },
          "409": {
            "description": "Email already registered"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Log in",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "email": "aysel@example.com",
                "password": "secret123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Returns user + JWT"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Get the logged-in user from a Bearer token",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user"
          },
          "401": {
            "description": "Missing/invalid token"
          }
        }
      }
    },
    "/operators": {
      "post": {
        "summary": "Create an operator profile - requires login; one profile per account",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "name": "Qafqaz Tours",
                "description": "Dag turlari",
                "languages": "az,en",
                "vehicle_features": "wifi,ac"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "401": {
            "description": "Missing/invalid token"
          },
          "409": {
            "description": "This account already has an operator profile - use PUT to update it instead"
          }
        }
      },
      "get": {
        "summary": "List operators",
        "responses": {
          "200": {
            "description": "Array of operators"
          }
        }
      }
    },
    "/operators/me": {
      "get": {
        "summary": "Get the logged-in account's own operator profile, if any - drives the Traveler/Operator mode toggle on the frontend",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operator profile, or null if this account isn't an operator yet"
          },
          "401": {
            "description": "Missing/invalid token"
          }
        }
      }
    },
    "/operators/{id}": {
      "get": {
        "summary": "Get one operator",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operator"
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "put": {
        "summary": "Update an operator profile - must be the owning account",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated operator"
          },
          "403": {
            "description": "Not the owning account"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/tours": {
      "post": {
        "summary": "Create a tour - requires login as an operator; operator_id is derived from the token and is not accepted in the request body",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "title": "Quba Tebiet Turu",
                "price": 50,
                "date": "2026-09-10"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "401": {
            "description": "Missing/invalid token"
          },
          "403": {
            "description": "This account has no operator profile yet"
          }
        }
      },
      "get": {
        "summary": "Search/list tours",
        "parameters": [
          {
            "name": "location",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "minPrice",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "maxPrice",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of tours"
          }
        }
      }
    },
    "/tours/compare": {
      "get": {
        "summary": "Compare 2-3 tours side by side",
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "1,2,3"
          }
        ],
        "responses": {
          "200": {
            "description": "Array of tours"
          },
          "400": {
            "description": "Must be 2-3 ids"
          }
        }
      }
    },
    "/tours/{id}": {
      "get": {
        "summary": "Get one tour (includes discounted_price if an active deal exists)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tour"
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "delete": {
        "summary": "Delete a tour - must be the owning operator. Blocked if bookings already exist unless ?force=true; cascades cleanup to bookings, group_formations, reviews, and last_minute_deals for that tour",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "force",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Delete anyway even if the tour has existing bookings"
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted"
          },
          "403": {
            "description": "Not the owning operator"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Tour has existing bookings - pass ?force=true to delete anyway"
          }
        }
      }
    },
    "/group-formations": {
      "get": {
        "summary": "Read-only lookup of a tour's current group state - does not create anything, safe to call just to preview status/price",
        "parameters": [
          {
            "name": "tour_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The tour's open (waiting/forming) group if one exists, otherwise its most recent confirmed group, otherwise null"
          },
          "400": {
            "description": "tour_id query param is required"
          }
        }
      }
    },
    "/group-formations/{id}": {
      "get": {
        "summary": "Get one group formation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Group formation with live price_per_person"
          }
        }
      }
    },
    "/group-formations/expire-past-due": {
      "post": {
        "summary": "Cancel any waiting/forming groups whose tour date has passed, and cancel any bookings still pending on them",
        "responses": {
          "200": {
            "description": "List of cancelled group ids and cancelled booking ids"
          }
        }
      }
    },
    "/bookings": {
      "post": {
        "summary": "Book a tour (simulated payment) - requires login; identity comes from the token, not the request body",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "tour_id": 5,
                "seats": 2,
                "payment": {
                  "card_number": "4242424242424242"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Booking + ticket_code"
          },
          "400": {
            "description": "Missing tour_id, seats, or payment"
          },
          "401": {
            "description": "Missing/invalid token"
          },
          "409": {
            "description": "Not enough spots left in the group"
          }
        }
      }
    },
    "/bookings/mine": {
      "get": {
        "summary": "An operator's bookings across ALL of their tours - for the operator dashboard",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Array of bookings, each with tour_title, tour_date, traveler_name, traveler_email"
          },
          "403": {
            "description": "This account has no operator profile"
          }
        }
      }
    },
    "/bookings/my-trips": {
      "get": {
        "summary": "The logged-in traveler's own bookings, across every tour they've booked - distinct from /bookings/mine, which is operator-scoped",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Array of bookings, each with tour_title, tour_date, tour_location"
          }
        }
      }
    },
    "/bookings/{id}": {
      "get": {
        "summary": "Get one booking / e-ticket - must be the traveler who made it",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Booking with nested tour info (title, date, location, route, operator_name)"
          },
          "403": {
            "description": "Not your booking"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/reviews": {
      "post": {
        "summary": "Post a review - updates the operator's rolled-up rating",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "tour_id": 5,
                "rating": 5,
                "comment": "Great trip!",
                "user": {
                  "name": "Aysel Mammadova",
                  "email": "aysel@example.com"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Review + operator_new_rating"
          }
        }
      },
      "get": {
        "summary": "List reviews for a tour",
        "parameters": [
          {
            "name": "tour_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of reviews"
          }
        }
      }
    },
    "/planner": {
      "post": {
        "summary": "Smart Planner - greedy budget/day-constrained tour selection",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "budget": 300,
                "days": 3,
                "interests": [
                  "nature",
                  "history"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Selected tours with reasons, total_price, remaining_budget"
          }
        }
      }
    }
  }
}