{
  "openapi": "3.0.3",
  "info": {
    "title": "TurPoint API",
    "version": "0.3.0",
    "description": "Tour marketplace API - operators, tours, group formation pricing, bookings, reviews, deals, and the smart trip planner. Most write operations and anything scoped to \"the logged-in account\" require a Bearer JWT; identity is always derived from the verified token, never from the request body. Sprint 3: all responses carry standard security headers (helmet); /api/auth/login and /api/auth/signup are rate-limited (20 requests/15min per IP) and every other route shares a broader 300 requests/15min ceiling; in production CORS is restricted to the configured frontend origin via CORS_ORIGIN."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "summary": "Create a new account",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "name": "Aysel Mammadova",
                "email": "aysel@example.com",
                "password": "secret123"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created, returns user + JWT"
          },
          "409": {
            "description": "Email already registered"
          },
          "429": {
            "description": "Rate limited - max 20 requests per 15 minutes per IP"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Log in",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "email": "aysel@example.com",
                "password": "secret123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Returns user + JWT"
          },
          "401": {
            "description": "Invalid credentials"
          },
          "429": {
            "description": "Rate limited - max 20 requests per 15 minutes per IP"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Get the logged-in user from a Bearer token",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user"
          },
          "401": {
            "description": "Missing/invalid token"
          }
        }
      }
    },
    "/operators": {
      "post": {
        "summary": "Create an operator profile - requires login; one profile per account",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "name": "Qafqaz Tours",
                "description": "Dag turlari",
                "languages": "az,en",
                "vehicle_features": "wifi,ac"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "401": {
            "description": "Missing/invalid token"
          },
          "409": {
            "description": "This account already has an operator profile - use PUT to update it instead"
          }
        }
      },
      "get": {
        "summary": "List operators",
        "responses": {
          "200": {
            "description": "Array of operators"
          }
        }
      }
    },
    "/operators/me": {
      "get": {
        "summary": "Get the logged-in account's own operator profile, if any - drives the Traveler/Operator mode toggle on the frontend",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operator profile, or null if this account isn't an operator yet"
          },
          "401": {
            "description": "Missing/invalid token"
          }
        }
      }
    },
    "/operators/{id}": {
      "get": {
        "summary": "Get one operator",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operator"
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "put": {
        "summary": "Update an operator profile - must be the owning account",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated operator"
          },
          "403": {
            "description": "Not the owning account"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/tours": {
      "post": {
        "summary": "Create a tour - requires login as an operator; operator_id is derived from the token and is not accepted in the request body. `features` is an optional comma-separated list of slugs from: breakfast, evening_tea, guide, road_games, hotel_stay - drives the homepage's feature-tag filter chips.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "title": "Quba Tebiet Turu",
                "price": 50,
                "date": "2026-09-10",
                "features": "breakfast,guide"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Missing title/price/date, non-positive price, or min_participants greater than max_participants"
          },
          "401": {
            "description": "Missing/invalid token"
          },
          "403": {
            "description": "This account has no operator profile yet"
          }
        }
      },
      "get": {
        "summary": "Search/list tours",
        "parameters": [
          {
            "name": "location",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "minPrice",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "maxPrice",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of tours"
          }
        }
      }
    },
    "/tours/compare": {
      "get": {
        "summary": "Compare 2-3 tours side by side",
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "1,2,3"
          }
        ],
        "responses": {
          "200": {
            "description": "Array of tours"
          },
          "400": {
            "description": "Must be 2-3 ids"
          }
        }
      }
    },
    "/tours/{id}": {
      "get": {
        "summary": "Get one tour (includes discounted_price if an active deal exists)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tour"
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "put": {
        "summary": "Update a tour - must be the owning operator. Partial update: only fields present in the body are changed",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "price": 60,
                "date": "2026-09-15"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated tour"
          },
          "400": {
            "description": "Invalid field value (e.g. empty title, non-positive price, min_participants greater than max_participants)"
          },
          "403": {
            "description": "Not the owning operator"
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "delete": {
        "summary": "Delete a tour - must be the owning operator. Blocked if bookings already exist unless ?force=true; cascades cleanup to bookings, group_formations, reviews, and last_minute_deals for that tour",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "force",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Delete anyway even if the tour has existing bookings"
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted"
          },
          "403": {
            "description": "Not the owning operator"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Tour has existing bookings - pass ?force=true to delete anyway"
          }
        }
      }
    },
    "/group-formations": {
      "get": {
        "summary": "Read-only lookup of a tour's current group state - does not create anything, safe to call just to preview status/price",
        "parameters": [
          {
            "name": "tour_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The tour's open (waiting/forming) group if one exists, otherwise its most recent confirmed group, otherwise null"
          },
          "400": {
            "description": "tour_id query param is required"
          }
        }
      }
    },
    "/group-formations/{id}": {
      "get": {
        "summary": "Get one group formation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Group formation with live price_per_person"
          }
        }
      }
    },
    "/group-formations/expire-past-due": {
      "post": {
        "summary": "Cancel any waiting/forming groups whose tour date has passed, and cancel any bookings still pending on them. Meant to be called by a scheduler, not end users.",
        "parameters": [
          {
            "name": "x-cron-secret",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Required only if the server has CRON_SECRET set (production). Must match its value. Left open in local dev where CRON_SECRET is unset."
          }
        ],
        "responses": {
          "200": {
            "description": "List of cancelled group ids and cancelled booking ids"
          },
          "401": {
            "description": "CRON_SECRET is set on the server and the x-cron-secret header is missing or doesn't match"
          }
        }
      }
    },
    "/bookings": {
      "post": {
        "summary": "Book a tour (simulated payment) - requires login; identity comes from the token, not the request body",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "tour_id": 5,
                "seats": 2,
                "payment": {
                  "card_number": "4242424242424242"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Booking + ticket_code"
          },
          "400": {
            "description": "Missing tour_id, seats, or payment; seats not a positive whole number; or seats exceeds the tour's max_participants"
          },
          "401": {
            "description": "Missing/invalid token"
          },
          "409": {
            "description": "Not enough spots left in the group"
          }
        }
      }
    },
    "/bookings/mine": {
      "get": {
        "summary": "An operator's bookings across ALL of their tours - for the operator dashboard",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Array of bookings, each with tour_title, tour_date, traveler_name, traveler_email"
          },
          "403": {
            "description": "This account has no operator profile"
          }
        }
      }
    },
    "/bookings/my-trips": {
      "get": {
        "summary": "The logged-in traveler's own bookings, across every tour they've booked - distinct from /bookings/mine, which is operator-scoped",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Array of bookings, each with tour_title, tour_date, tour_location"
          }
        }
      }
    },
    "/bookings/{id}": {
      "get": {
        "summary": "Get one booking / e-ticket - must be the traveler who made it",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Booking with nested tour info (title, date, location, route, operator_name)"
          },
          "403": {
            "description": "Not your booking"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/reviews": {
      "post": {
        "summary": "Post a review - requires login and a confirmed booking on the tour (verified buyers only); identity comes from the token, not the request body. Updates the operator's rolled-up rating. One review per user per tour.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "tour_id": 5,
                "rating": 5,
                "comment": "Great trip!"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Review + operator_new_rating"
          },
          "400": {
            "description": "Missing tour_id/rating, or rating not between 1 and 5"
          },
          "401": {
            "description": "Missing/invalid token"
          },
          "403": {
            "description": "No confirmed booking on this tour by this user - reviews are restricted to verified buyers"
          },
          "404": {
            "description": "Tour not found"
          },
          "409": {
            "description": "You already reviewed this tour - use PUT /api/reviews/{id} to edit it"
          },
          "429": {
            "description": "Rate limited - too many reviews created recently (5 per 60 minutes per account, across all tours)"
          }
        }
      },
      "get": {
        "summary": "List reviews for a tour",
        "parameters": [
          {
            "name": "tour_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of reviews"
          }
        }
      }
    },
    "/reviews/{id}": {
      "put": {
        "summary": "Edit your own review (rating and/or comment) - requires login and ownership. Re-runs the operator rating rollup.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "rating": 4,
                "comment": "Updated my thoughts after a second look."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated review + operator_new_rating"
          },
          "400": {
            "description": "Neither rating nor comment provided, or rating not between 1 and 5"
          },
          "401": {
            "description": "Missing/invalid token"
          },
          "403": {
            "description": "You can only edit your own review"
          },
          "404": {
            "description": "Review not found"
          }
        }
      },
      "delete": {
        "summary": "Delete your own review - requires login and ownership. Re-runs the operator rating rollup.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "{ deleted: true, id, operator_new_rating }"
          },
          "401": {
            "description": "Missing/invalid token"
          },
          "403": {
            "description": "You can only delete your own review"
          },
          "404": {
            "description": "Review not found"
          }
        }
      }
    },
    "/deals": {
      "post": {
        "summary": "Create a last-minute deal on a tour - requires login as the owning operator",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "tour_id": 5,
                "discount_percent": 20,
                "expires_at": "2026-09-05T23:59:59Z"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created deal"
          },
          "400": {
            "description": "Missing fields, or discount_percent not between 1 and 99"
          },
          "401": {
            "description": "Missing/invalid token"
          },
          "403": {
            "description": "You do not own this tour"
          },
          "404": {
            "description": "Tour not found"
          }
        }
      },
      "get": {
        "summary": "List currently-active (non-expired) deals",
        "responses": {
          "200": {
            "description": "Array of deals, each with tour_title and tour_price"
          }
        }
      }
    },
    "/planner": {
      "post": {
        "summary": "Smart Planner - greedy budget/day-constrained tour selection",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "budget": 300,
                "days": 3,
                "interests": [
                  "nature",
                  "history"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Selected tours with reasons, total_price, remaining_budget"
          }
        }
      }
    }
  }
}